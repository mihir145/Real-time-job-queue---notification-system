# ──────────────────────────────────────────────
# React / Vite .gitignore
# ──────────────────────────────────────────────

# Dependencies
node_modules/

# Vite build output
dist/
dist-ssr/

# Vite cache
.vite/
vite.config.js.timestamp-*

# Test coverage
coverage/

# Environment secrets
.env
.env.*
!.env.example

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db
